# ─── LLM API 配置 ───
# 默认走 OpenAI gpt-4o-mini,旅行时账户记得充值

LLM_API_KEY=sk-your-openai-api-key-here
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# ─── 切其他兼容 OpenAI 格式的提供商,代码不用动 ───
# DeepSeek (开发/测试便宜):
#   LLM_API_KEY=sk-...
#   LLM_ENDPOINT=https://api.deepseek.com/chat/completions
#   LLM_MODEL=deepseek-chat
#
# Kimi (国内访问稳):
#   LLM_API_KEY=...
#   LLM_ENDPOINT=https://api.moonshot.cn/v1/chat/completions
#   LLM_MODEL=moonshot-v1-8k

# ─── Vercel Blob (照片上传) ───
# 这一项不要手动填 —— 在 Vercel 控制台 Storage 里点 Create Blob 之后,
# Vercel 会自动注入这个变量到所有部署
# BLOB_READ_WRITE_TOKEN=
